<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>AiCompanion</AssemblyName>
    <RootNamespace>AiCompanion.App</RootNamespace>
    <ApplicationIcon>Assets\Orua.ico</ApplicationIcon>
    <!-- 版本三处同源：此处给 exe 文件/产品版本，backend /health 给运行时版本，
         前端脚注 boot 时读 /health 覆盖，避免 UI 与实际后端产物各说各话。 -->
    <Version>4.1.0</Version>
    <Product>Orua</Product>
    <Description>Orua — Windows 桌面 AI 陪伴（多 Bot + 群聊围观）</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\Orua.ico" />
    <Resource Include="Assets\Orua.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
